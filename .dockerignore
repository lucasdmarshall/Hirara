# Keep the build context minimal — anything copied in becomes an immutable
# image layer, so a secret that lands here is not removed by deleting it later.
.venv/
**/target/
*.whl

__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
.git/
tests/

# Credentials and local state. The leading patterns are deliberately broad:
# a notes file with a password in it must never reach an image layer.
.env
*.env
*cache.db*
*[Ss]erver*[Aa]ccess*
*[Cc]redential*
*[Ss]ecret*
id_rsa*
*.pem
*.key
